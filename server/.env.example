# Gemini sessions default to Production (paid). Testing uses the free key when selected.
# Get keys at https://aistudio.google.com/apikey
GEMINI_API_KEY_FREE=your-free-key-here
GEMINI_API_KEY_PAID=your-paid-key-here

# Used only when the speaker selects OpenAI GPT.
OPENAI_API_KEY=your-openai-key-here

# Optional: switch a live model without a code change (defaults shown).
# GEMINI_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
# OPENAI_TRANSLATE_MODEL=gpt-realtime-translate
# OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe

# Optional: require this password before anyone can create a speaker session.
# PASSWORD=choose-a-speaker-password

# Port the server listens on
PORT=8080

# Optional: public URL used in QR codes / join links when deployed behind a
# domain or tunnel (e.g. https://translate.yourchurch.org). Leave unset for
# local network use — the server then uses the address the speaker connected with.
# PUBLIC_BASE_URL=

# Optional: fixed code for the recurring weekly session (default SERMON).
# Its join link/QR never changes, so it can be printed and reused every week.
# Must be 6 letters or digits.
# WEEKLY_SESSION_ID=SERMON

# Optional: email the weekly session's sermon transcript after each service
# window. Off unless BREVO_API_KEY, SERMON_EMAIL_TO, SERMON_EMAIL_FROM and
# SERMON_WINDOWS are all set. SERMON_EMAIL_FROM must be a verified Brevo sender.
# BREVO_API_KEY=
# SERMON_EMAIL_TO=you@example.com
# Optional hidden copy (BCC) of each email, e.g. for the person maintaining Glotta.
# SERMON_EMAIL_COPY_TO=you@example.com
# SERMON_EMAIL_FROM=you@example.com
# SERMON_EMAIL_FROM_NAME=Glotta
# SERMON_TIMEZONE=America/Chicago
# SERMON_WINDOWS=Sun 11:00-12:20, Sun 18:10-19:20
# Gemini (gemini-...) or OpenAI (gpt-..., o4-mini...) model that finds the sermon
# and then proofreads it, in separate calls.
# SERMON_EMAIL_MODEL=gemini-3.5-flash
# Model for the third attempt of a call that failed twice (default gpt-6-luna).
# SERMON_EMAIL_FALLBACK_MODEL=gpt-6-luna
# Gemini model that transcribes the recorded service audio; off uses the live transcript.
# SERMON_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Instructions for what counts as the sermon (a built-in default is used if unset).
# SERMON_TRIM_PROMPT=
# Instructions for correcting the sermon (a built-in default is used if unset).
# SERMON_PROOFREAD_PROMPT=
# Proofreading is on unless this is off.
# SERMON_PROOFREAD=off

# Gemini sessions default to Free. Paid is available when the speaker selects it.
# Get keys at https://aistudio.google.com/apikey
GEMINI_API_KEY_FREE=your-free-key-here
GEMINI_API_KEY_PAID=your-paid-key-here

# Used only when the speaker selects OpenAI GPT.
OPENAI_API_KEY=your-openai-key-here

# Optional: require this password before anyone can create a speaker session.
# PASSWORD=choose-a-speaker-password

# Port the server listens on
PORT=8080

# Optional: public URL used in QR codes / join links when deployed behind a
# domain or tunnel (e.g. https://translate.yourchurch.org). Leave unset for
# local network use — the server then uses the address the speaker connected with.
# PUBLIC_BASE_URL=

# Optional: fixed code for the recurring weekly session (default SERMON).
# Its join link/QR never changes, so it can be printed and reused every week.
# Must be 6 letters or digits.
# WEEKLY_SESSION_ID=SERMON
